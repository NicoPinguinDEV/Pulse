# Vorlage für /etc/pulse-host-agent.env (chmod 600, Besitzer root). NUR Platzhalter – echtes Token selbst erzeugen:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Dasselbe Token gehört als PULSE_HOST_AGENT_TOKEN in die Pulse-.env.
PULSE_AGENT_TOKEN=HIER_EIN_LANGES_ZUFAELLIGES_TOKEN_EINTRAGEN
# Empfohlen: Unix-Socket im bind-gemounteten Pulse-Ordner (im Container: /app/.pulse-agent/agent.sock)
PULSE_AGENT_SOCKET=/opt/pulse/Pulse/.pulse-agent/agent.sock
# Alternative ohne Socket (nur private Adresse, z. B. Gateway des Compose-Netzes); dann PULSE_AGENT_SOCKET leer lassen:
# PULSE_AGENT_BIND=172.30.0.1
# PULSE_AGENT_PORT=25096
PULSE_REPO_DIR=/opt/pulse/Pulse
PULSE_CONTAINER=pulse-teamos
PULSE_COMPOSE_SERVICE=pulse
PULSE_HEALTH_URL=http://127.0.0.1:25095/healthz
PULSE_DEPLOY_HEALTH_SECONDS=240
