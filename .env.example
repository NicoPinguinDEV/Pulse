# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Maximum number of recent Discord messages kept in RAM (100–1000; default 250).
# Reply context is fetched on demand if the corresponding message is no longer cached.
DISCORD_MESSAGE_CACHE_SIZE=250
# Must exactly match a Redirect URI saved in the Discord Developer Portal.
DISCORD_REDIRECT_URI=https://your-domain.example/callback
# Optional fallback only if DISCORD_REDIRECT_URI is empty. If both are set,
# the existing dashboard callback is reused for the application login.
DISCORD_APPLICATION_REDIRECT_URI=

# Public dashboard
PUBLIC_BASE_URL=https://your-domain.example
SERVER_PORT=25095
PANEL_TIMEZONE=Europe/Berlin
# Mindestens 32 zufällige Zeichen (z. B. python -c "import secrets; print(secrets.token_hex(32))").
# Der Platzhalter oder kürzere Werte werden ignoriert: Pulse nutzt dann die erzeugte .session_secret und warnt.
SESSION_SECRET=change-me-to-a-long-random-secret
# Dashboard-Sitzungen enden nach so vielen Stunden ohne Aktivität (U-14, Standard 24, mindestens 0.25)
PULSE_SESSION_IDLE_HOURS=24
# Maximale Login-Dauer in Tagen (1–365, Standard 7).
# SESSION_DAYS=7
# Uvicorn: Adresse, an die das Dashboard bindet (Standard 0.0.0.0 – im Docker-Container so lassen; nach außen
# begrenzt compose.yaml über PULSE_PUBLISH_HOST). X-Forwarded-For wird nur von diesen IPs vertraut (Reverse-Proxy).
# Docker Compose setzt standardmäßig 172.30.0.10,172.30.0.1 (Caddy-Container bzw. Caddy auf dem Host über das
# Netz-Gateway). Steht im Anmeldeprotokoll bei allen dieselbe 172.30.0.x-Adresse, fehlt hier die Proxy-IP.
# PULSE_BIND_HOST=0.0.0.0
# PULSE_FORWARDED_ALLOW_IPS=127.0.0.1

# Persistence
PULSE_DB_PATH=pulse.db

# Team / warnings
TEAM_UPDATE_CHANNEL_NAME=
# Warnrollen 1–5 sind für diesen Pulse-Server fest im Code hinterlegt:
# 1 = 1489221948348043395
# 2 = 1489222076370780232
# 3 = 1531760107971416135
# 4 = 1556344459422081045
# 5 = 1556344484198088814
# Warnrollen automatisch vergeben: nur 1 (an) oder 0 (aus) – andere Werte, auch "true", gelten als aus.
SYNC_WARN_ROLES=1
# Vergessene Schichten werden nach 24 h automatisch beendet und zählen 0 h, bis eine höherrangige Führungskraft
# die echte Dauer in der Teamakte bestätigt (E-2). MAX_SHIFT_HOURS ist die Obergrenze dafür (0.5–24, Standard 12).
MAX_SHIFT_HOURS=12
AUTO_BACKUP_HOURS=24
MAX_BACKUPS=30
# Optional: Backups zusätzlich in einen privaten Discord-Channel hochladen.
# Alternativ kann der Kanal im Discord mit /setup_backup gespeichert werden.
PULSE_BACKUP_DISCORD_CHANNEL_ID=

# Pulse KI-Support (für kostenlose Gemini-Nutzung)
PULSE_SUPPORT_ENABLED=false
PULSE_SUPPORT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ersatzmodelle, falls GEMINI_MODEL beim Anbieter unbekannt ist (HTTP 404). Leer = Standardliste, "off" = keine.
# PULSE_SUPPORT_FALLBACK_MODELS=gemini-3.1-flash-lite-preview,gemini-2.5-flash-lite
# Denkaufwand der Thinking-Modelle (none|minimal|low|medium|high|off). Standard bei Gemini: low,
# damit das Token-Budget nicht vom versteckten Denkprozess aufgebraucht wird (leere Antworten).
# PULSE_SUPPORT_REASONING_EFFORT=low
# Ohne erreichbare KI passende Stellen aus der Wissensbasis zitieren (Standard: true).
# PULSE_SUPPORT_OFFLINE_FALLBACK=true
# Nur bei PULSE_SUPPORT_PROVIDER=openai (kostenpflichtig, optional):
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# Wissensbasis und Antwortvorlagen der KI (Standard: Dateien im Projektordner)
# SUPPORT_KNOWLEDGE_FILE=support_knowledge.md
# PULSE_SUPPORT_TEMPLATES_FILE=team_ki_vorlagen.md
PULSE_SUPPORT_CHANNEL_ID=1493649456086782083
# Optional: zusätzlicher privater Team-KI-Hilfekanal (leer = deaktiviert).
PULSE_SUPPORT_TEAM_CHANNEL_ID=
# Optional: kommaseparierte Team-Rollen-IDs; wenn gesetzt, dürfen nur diese Rollen die Team-KI nutzen.
# Wenn leer, schützen die Discord-Kanalberechtigungen den privaten Teamkanal.
PULSE_SUPPORT_TEAM_ROLE_IDS=
# Antwortumfang: 300–2200 Tokens (Standard 1100).
PULSE_SUPPORT_MAX_TOKENS=1100

# Pulse KI-Moderation: prüft Textnachrichten im konfigurierten Server
# Nur aktivieren, nachdem Mitglieder über die externe KI-Prüfung informiert wurden.
PULSE_AI_MODERATION_ENABLED=false
# ID eines PRIVATEN Team-/Moderations-Prüfkanals (nicht den öffentlichen Support-Kanal verwenden)
PULSE_AI_MODERATION_REVIEW_CHANNEL_ID=0
# Nachrichten werden der Reihe nach geprüft; größere Werte senken den API-Verbrauch.
PULSE_AI_MODERATION_INTERVAL_SECONDS=4
PULSE_AI_MODERATION_CONFIDENCE=0.72
# Für niedrige Schwere wird mehr Sicherheit gefordert; Standardeinstellung 85 %.
PULSE_AI_MODERATION_LOW_CONFIDENCE=0.85
# Veraltete Nachrichten nach API-Ausfällen nicht mehr prüfen (Standard: 5 Minuten).
PULSE_AI_MODERATION_MAX_QUEUE_AGE_SECONDS=300
# Höchstens so viele Nachrichten warten auf die Prüfung (10–250, Standard 100) – begrenzt den RAM.
# PULSE_AI_MODERATION_QUEUE_SIZE=100
# Hinweis bei KI-Ausfall höchstens alle so viele Sekunden (3600–86400, Standard 21600).
# PULSE_AI_MODERATION_OUTAGE_NOTICE_INTERVAL_SECONDS=21600
# Ablage der KI-Moderationsfälle (Standard: ai_moderation_cases.json im Projektordner)
# PULSE_AI_MODERATION_CASES_FILE=ai_moderation_cases.json
# Den konfigurierten internen Team-KI-Chat standardmäßig nicht als Moderationsfläche prüfen.
PULSE_AI_MODERATION_EXCLUDE_TEAM_KI=true
# Bürgerrollen: 1531303733311307997 und 1531459374004834424 (fest im Code)
# Teamrollen werden aus den Pulse-Team-Einstellungen in config.json gelesen.
PULSE_AI_MODERATION_EXCLUDED_CHANNEL_IDS=
PULSE_AI_MODERATION_EXCLUDED_CATEGORY_IDS=

# Social-Promo: RSSHub-Instanz (Standard https://rsshub.app) und Ablage der überwachten Profile
# PULSE_RSSHUB_BASE_URL=https://rsshub.app
# PULSE_SOCIAL_PROMO_FILE=social_promo_sources.json
# Ablage des Ankündigungsarchivs (Standard: pulse_announcement_archive.json im Projektordner)
# PULSE_ANNOUNCEMENT_ARCHIVE_CONFIG=pulse_announcement_archive.json
# Social-Promo: optional RSSHub-Mirror-Fallbacks (kommasepariert).
# Diese sind öffentliche Drittanbieter; die überwachten Profilnamen werden an sie angefragt.
# Leer lassen, um Fallbacks abzuschalten. Ohne Variable nutzt Pulse die Standard-Mirrors.
PULSE_RSSHUB_FALLBACK_URLS=https://rsshub.rssforever.com,https://rsshub.feeded.xyz,https://hub.slarker.me

# Optional: Textkanal für einmalige Pulse-RAM-Warnungen ab 500/620/700 MB (E-5, Containerlimit 768 MiB).
# O-07: derselbe Kanal erhält gedrosselte Alarme (je Ursache höchstens alle 30 min) bei fehlgeschlagenen
# Hintergrundjobs, Auto-/Komplett-Backups, Restore-Tests und nicht erreichbarer Datenbank.
# Leer lassen, wenn Warnungen nur in der Hosting-Konsole erscheinen sollen.
PULSE_SYSTEM_ALERT_CHANNEL_ID=
# Kanal für Wochenberichte der Operations Suite (leer = in der Suite einstellbar)
# PULSE_REPORT_CHANNEL_ID=

# Komplett-Backup: Dateibudget je Backup (Uploads/Transkripte) und Gesamtgrenze aller Komplett-Backups in MB
PULSE_BACKUP_MAX_MB=500
PULSE_BACKUP_TOTAL_MAX_MB=4000

# Slash-Befehle werden nur bei geaendertem Befehlsbaum synchronisiert. 1 = beim naechsten Start erzwingen
# (z. B. nach Aenderungen im Developer Portal oder einem Datenbank-Restore). Alternativ: Knopf im Systemstatus.
PULSE_FORCE_COMMAND_SYNC=0

# Raid-/Spam-Frühwarnung (BOT-08): nur Alarm ans Team, keine automatische Änderung. 0 = aus
PULSE_RAID_WATCH=1
# Schwellen (optional)
PULSE_RAID_JOINS_PER_MINUTE=10
PULSE_RAID_NEW_ACCOUNTS_5MIN=5
PULSE_RAID_NEW_ACCOUNT_DAYS=7
PULSE_RAID_MASS_MENTIONS=8
PULSE_RAID_COPY_CHANNELS=3

# Spiel-Anbindung (F-09, optional): Roblox Universe-ID des Spiels. Pulse fragt dann die offizielle, öffentliche
# Roblox-API (games.roblox.com) nach Spielerzahl/Serverstatus ab – ohne Schlüssel. Leer = keine Abfrage.
# Zusätzlich unter Verwaltung → Neue Funktionen „Spiel-Anbindung“ einschalten.
PULSE_ROBLOX_UNIVERSE_ID=

# Server Control Center (Verwaltung → Serververwaltung). Ohne diese Werte zeigt die Seite Container-, Git- und
# Deploy-Werte als "nicht verfügbar"; Deploy/Neustart/Rollback sind dann gesperrt. Einrichtung: docs/SERVER_CONTROL_CENTER.md
# Empfohlen (Unix-Socket im Pulse-Ordner):  unix:///app/.pulse-agent/agent.sock   ·   Alternative: http://172.30.0.1:25096
PULSE_HOST_AGENT_URL=
# Gleiches Token wie PULSE_AGENT_TOKEN in /etc/pulse-host-agent.env (mind. 32 Zeichen, nur Platzhalter hier)
PULSE_HOST_AGENT_TOKEN=
# Öffentliches GitHub-Repository für den Commit-Vergleich ohne Token (leer = Vergleich abschalten)
# PULSE_GITHUB_REPO=NicoPinguinDEV/Pulse
