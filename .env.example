# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
# Maximum number of recent Discord messages kept in RAM (100–1000; default 250).
# Reply context is fetched on demand if the corresponding message is no longer cached.
DISCORD_MESSAGE_CACHE_SIZE=250
# Must exactly match a Redirect URI saved in the Discord Developer Portal.
DISCORD_REDIRECT_URI=https://your-domain.example/callback
# Optional fallback only if DISCORD_REDIRECT_URI is empty. If both are set,
# the existing dashboard callback is reused for the application login.
DISCORD_APPLICATION_REDIRECT_URI=

# Public dashboard
PUBLIC_BASE_URL=https://your-domain.example
SERVER_PORT=25095
PANEL_TIMEZONE=Europe/Berlin
SESSION_SECRET=change-me-to-a-long-random-secret

# Persistence
PULSE_DB_PATH=pulse.db

# Team / warnings
TEAM_UPDATE_CHANNEL_NAME=
# Warnrollen 1–5 sind für diesen Pulse-Server fest im Code hinterlegt:
# 1 = 1489221948348043395
# 2 = 1489222076370780232
# 3 = 1531760107971416135
# 4 = 1556344459422081045
# 5 = 1556344484198088814
SYNC_WARN_ROLES=1
MAX_SHIFT_HOURS=12
AUTO_BACKUP_HOURS=24
MAX_BACKUPS=30
# Optional: Backups zusätzlich in einen privaten Discord-Channel hochladen.
# Alternativ kann der Kanal im Discord mit /setup_backup gespeichert werden.
PULSE_BACKUP_DISCORD_CHANNEL_ID=

# Pulse KI-Support (für kostenlose Gemini-Nutzung)
PULSE_SUPPORT_ENABLED=false
PULSE_SUPPORT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PULSE_SUPPORT_CHANNEL_ID=1493649456086782083
# Optional: zusätzlicher privater Team-KI-Hilfekanal (leer = deaktiviert).
PULSE_SUPPORT_TEAM_CHANNEL_ID=
# Optional: kommaseparierte Team-Rollen-IDs; wenn gesetzt, dürfen nur diese Rollen die Team-KI nutzen.
# Wenn leer, schützen die Discord-Kanalberechtigungen den privaten Teamkanal.
PULSE_SUPPORT_TEAM_ROLE_IDS=
# Antwortumfang: 300–2200 Tokens (Standard 1100).
PULSE_SUPPORT_MAX_TOKENS=1100

# Pulse KI-Moderation: prüft Textnachrichten im konfigurierten Server
# Nur aktivieren, nachdem Mitglieder über die externe KI-Prüfung informiert wurden.
PULSE_AI_MODERATION_ENABLED=false
# ID eines PRIVATEN Team-/Moderations-Prüfkanals (nicht den öffentlichen Support-Kanal verwenden)
PULSE_AI_MODERATION_REVIEW_CHANNEL_ID=0
# Nachrichten werden der Reihe nach geprüft; größere Werte senken den API-Verbrauch.
PULSE_AI_MODERATION_INTERVAL_SECONDS=4
PULSE_AI_MODERATION_CONFIDENCE=0.72
# Für niedrige Schwere wird mehr Sicherheit gefordert; Standardeinstellung 85 %.
PULSE_AI_MODERATION_LOW_CONFIDENCE=0.85
# Veraltete Nachrichten nach API-Ausfällen nicht mehr prüfen (Standard: 5 Minuten).
PULSE_AI_MODERATION_MAX_QUEUE_AGE_SECONDS=300
# Den konfigurierten internen Team-KI-Chat standardmäßig nicht als Moderationsfläche prüfen.
PULSE_AI_MODERATION_EXCLUDE_TEAM_KI=true
# Bürgerrollen: 1531303733311307997 und 1531459374004834424 (fest im Code)
# Teamrollen werden aus den Pulse-Team-Einstellungen in config.json gelesen.
PULSE_AI_MODERATION_EXCLUDED_CHANNEL_IDS=
PULSE_AI_MODERATION_EXCLUDED_CATEGORY_IDS=

# Social-Promo: optional RSSHub-Mirror-Fallbacks (kommasepariert).
# Diese sind öffentliche Drittanbieter; die überwachten Profilnamen werden an sie angefragt.
# Leer lassen, um Fallbacks abzuschalten. Ohne Variable nutzt Pulse die Standard-Mirrors.
PULSE_RSSHUB_FALLBACK_URLS=https://rsshub.rssforever.com,https://rsshub.feeded.xyz,https://hub.slarker.me

# Optional: Textkanal für einmalige Pulse-RAM-Warnungen ab 180/210/230 MB.
# Leer lassen, wenn Warnungen nur in der Hosting-Konsole erscheinen sollen.
PULSE_SYSTEM_ALERT_CHANNEL_ID=
